{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": true,
    "noImplicitAny": false,
    "module": "commonjs",
    "target": "es2019",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@sdk/*": [
        "sdk/*"
      ],
      "@widget/*": [
        "widget/*"
      ],
      "@defaultWidget/*": [
        "widget/DefaultWidget/*"
      ],
      "@root/*": [
        "*"
      ]
    }
  },
  "include": [
    "sdk/**/*",
    "widget/**/*",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}
