{
  "name": "elixirchat-js-sdk",
  "version": "4.7.6",
  "description": "JavaScript SDK for https://elixir.chat",
  "scripts": {
    "dev": "./bin/dev.sh",
    "build": "./bin/build.sh",
    "deploy": "./bin/deploy.sh",
    "release": "./bin/release.sh",
    "examples": "./bin/examples.sh",
    "preinstall": "./bin/preinstall.sh",
    "postinstall": "./bin/postinstall.sh",
    "preversion": "./bin/preversion.sh",
    "link-with-backend": "./bin/link-with-backend.sh",
    "update-icon-font": "./bin/update-icon-font.sh"
  },
  "main": "./sdk/index.js",
  "sdk": "build/sdk.min.js",
  "widget": "build/default-widget.min.js",
  "targets": {
    "main": false,
    "default": {
      "source": "dev.html",
      "distDir": "dist"
    },
    "sdk": {
      "source": "sdk/index.ts",
      "distDir": "build"
    },
    "widget": {
      "source": "widget/index.ts",
      "distDir": "build"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elixirchat/elixirchat-js-sdk.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/elixirchat/elixirchat-js-sdk/issues"
  },
  "homepage": "https://github.com/elixirchat/elixirchat-js-sdk#readme",
  "dependencies": {
    "@absinthe/socket": "^0.2.1",
    "@lottiefiles/react-lottie-player": "^3.6.0",
    "@sentry/browser": "^5.22.3",
    "core-js": "^3.39.0",
    "dayjs": "^1.8.35",
    "phoenix": "^1.5.4",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-intl": "^6.0.3",
    "react-textarea-autosize": "^7.1.0",
    "unique-names-generator": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@parcel/transformer-inline-string": "^2.16.4",
    "concurrently": "^4.1.2",
    "http-server": "^0.12.3",
    "parcel": "^2.16.4",
    "sass": "^1.97.3",
    "typescript": "^4.5.5",
    "watch": "^1.0.2"
  }
}
